NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
APP_VERSION=dev
DATABASE_URL=postgres://financas_app:app_dev_password@localhost:5433/financas
DATABASE_MIGRATION_URL=postgres://financas_owner:owner_dev_password@localhost:5433/financas

# Web address used in email links (ADR 0021). Required in production; defaults to the Vite dev server
# PUBLIC_URL=https://financas.example.com
# Let anyone create an account from the login page (true/false). Off by default
PUBLIC_SIGNUP_ENABLED=false
# Proxies in front of the app whose X-Forwarded-For entries are trusted (0 = none, 1 = Traefik).
# The client address is the entry the outermost trusted proxy saw; anything to its left is ignored
TRUSTED_PROXY_HOPS=0
# Login lockout: failed attempts allowed per email and per client address within the window
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_FAILURE_WINDOW_MINUTES=15
# Account emails (sign-up, verification, forgot password) allowed per hour, per address and per client
# ACCOUNT_EMAILS_PER_ADDRESS_PER_HOUR=3
# ACCOUNT_EMAILS_PER_IP_PER_HOUR=10

# Email (ADR 0022). Without SMTP_HOST, emails are written as .eml files to EMAIL_OUTBOX_DIR.
# Production requires SMTP_HOST and EMAIL_FROM. The connection always requires TLS 1.2 or later.
# SMTP server of your email provider
# SMTP_HOST=smtp.example.com
# 587 uses STARTTLS; 465 uses implicit TLS
# SMTP_PORT=587
# Force implicit TLS on or off; by default it's on only for port 465
# SMTP_SECURE=false
# SMTP login, set both or neither
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# Sender address and the name shown in the inbox
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Finanças
# Where development emails are written, relative to apps/api when run with pnpm dev
EMAIL_OUTBOX_DIR=../../.private/outbox
