    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
