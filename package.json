{
  "name": "financas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "pnpm lint && pnpm lint:comments && pnpm lint:file-roles && pnpm lint:tokens && pnpm lint:copy && pnpm check:contrast && pnpm check:email-colors && pnpm check:owl-motion && pnpm typecheck && pnpm depcruise && pnpm test && pnpm docs:check",
    "prepare": "lefthook install || true",
    "lint:comments": "node scripts/check-no-comments.mjs",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:reset": "docker compose -f compose.dev.yml down --volumes && pnpm db:up",
    "db:generate": "pnpm --filter @financas/api db:generate",
    "db:migrate": "pnpm --filter @financas/api db:migrate",
    "test:integration": "pnpm --filter @financas/api test:integration",
    "ops:create-user": "pnpm --filter @financas/api ops:create-user",
    "ops:migrate": "pnpm --filter @financas/api ops:migrate",
    "ops:health": "node scripts/ops/health.mjs",
    "ops:logs": "node scripts/ops/logs.mjs",
    "ops:trace": "node scripts/ops/trace.mjs",
    "ops:errors": "node scripts/ops/errors.mjs",
    "ops:metrics": "node scripts/ops/metrics.mjs",
    "ops:job": "node scripts/ops/job.mjs",
    "lint:file-roles": "node scripts/check-file-roles.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:copy": "node scripts/check-copy.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "gen:email-colors": "node scripts/generate-email-colors.mjs",
    "check:email-colors": "node scripts/generate-email-colors.mjs --check",
    "gen:owl-motion": "node scripts/generate-owl-motion.mjs",
    "gen:app-icons": "node scripts/generate-app-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:owl-motion": "node scripts/generate-owl-motion.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "lefthook": "^2.1.14",
    "oxc-parser": "^0.151.0",
    "typescript": "^7.0.2"
  }
}
